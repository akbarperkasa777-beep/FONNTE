# =========================================================
# Salin file ini menjadi ".env" lalu isi dengan data kalian.
# JANGAN PERNAH commit file ".env" (yang sudah terisi) ke GitHub.
# =========================================================

# Konfigurasi Database
DB_HOST=localhost
DB_NAME=project_api_whatsapp
DB_USER=root
DB_PASS=

# Konfigurasi Fonnte (Tahap E - Persiapan Akun Fonnte)
# Ambil token dari dashboard Fonnte: https://fonnte.com/
FONNTE_TOKEN=TOKEN_FONNTE_KALIAN
FONNTE_API_URL=https://api.fonnte.com/send
